@model List<ToDoListMVC.Models.Gorev>

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Görev Listesi</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .btn-custom {
            background: linear-gradient(45deg, #ff9a9e, #fad0c4);
            border: none;
            color: #fff;
            padding: 6px 12px;
            font-size: 12px;
            border-radius: 18px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            transition: all 0.3s ease-in-out;
        }

            .btn-custom:hover {
                background: linear-gradient(45deg, #fad0c4, #ff9a9e);
                transform: translateY(-2px);
                box-shadow: 0 6px 8px rgba(0, 0, 0, 0.2);
            }

        .task-card {
            margin-bottom: 10px;
            border: 1px solid #ddd;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            transition: transform 0.3s ease-in-out;
        }

            .task-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
            }

            .task-card .card-header {
                font-weight: bold;
                font-size: 14px;
                padding: 8px;
            }

            .task-card .card-body {
                padding: 8px;
            }

            .task-card .card-footer {
                background-color: #f8f9fa;
                border-top: 1px solid #ddd;
                padding: 6px 10px;
                text-align: right;
            }

        .priority-high {
            background-color: #ffcccc;
        }

        .priority-medium {
            background-color: #fff3cd;
        }

        .priority-low {
            background-color: #d4edda;
        }

        .search-container {
            margin-bottom: 10px;
            display: flex;
            justify-content: center;
        }

        #search {
            width: 50%;
            max-width: 300px;
        }

        .deadline-warning {
            color: red;
            font-weight: bold;
            font-size: 12px;
        }

        .deadline-approaching {
            color: orange;
            font-weight: bold;
            font-size: 12px;
        }

        .deadline-completed {
            color: green;
            font-weight: bold;
            font-size: 12px;
        }

        .text-center {
            font-size: 16px;
        }

        .task-count {
            background-color: #f1f1f1;
            padding: 10px;
            margin-bottom: 20px;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            font-weight: bold;
            font-size: 18px;
            text-align: center;
        }
    </style>
</head>
<body>

    <div class="container mt-5">
        <h2 class="text-center mb-4">📌 Görev Listesi</h2>

        <!-- Başarı ve Hata Mesajları -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success text-center">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger text-center">@TempData["ErrorMessage"]</div>
        }

        <!-- Toplam Görev Sayısını Gösterme -->
        <div class="task-count">
            Toplam Görev Sayısı: @Model.Count
        </div>

        <!-- Yeni Görev Ekle Butonu -->
        <div class="text-center mb-4">
            <a asp-action="VCreate" class="btn btn-custom">➕ Yeni Görev Ekle</a>
        </div>

        <!-- Arama Kutusu -->
        <div class="search-container">
            <input type="text" id="search" class="form-control" placeholder="Görev Ara..." onkeyup="searchTask()" />
        </div>

        <!-- Görev Listesi Kartları -->
        <div class="row">
            @if (Model != null && Model.Count > 0)
            {
                @foreach (var gorev in Model)
                {
                    <div class="col-md-4">
                        <div class="card task-card @(gorev.Priority == "Yüksek" ? "priority-high" : gorev.Priority == "Orta" ? "priority-medium" : "priority-low")">
                            <div class="card-header">
                                @gorev.TaskName
                            </div>
                            <div class="card-body">
                                <p><strong>Atanan Kişi:</strong> @gorev.AssignedBy</p>
                                <p><strong>Önem Derecesi:</strong> <span class="badge @(gorev.Priority == "Yüksek" ? "bg-danger" : gorev.Priority == "Orta" ? "bg-warning" : "bg-success")">@gorev.Priority</span></p>
                                <p><strong>Açıklama:</strong> @gorev.Description</p>
                                <p><strong>Bitiş Tarihi:</strong> @(gorev.Deadline.HasValue ? gorev.Deadline.Value.ToString("dd MMM yyyy") : "Belirtilmedi")</p>

                                @if (gorev.Deadline.HasValue)
                                {
                                    var remainingTime = gorev.Deadline.Value - DateTime.Now;
                                    if (remainingTime < TimeSpan.Zero)
                                    {
                                        <p class="deadline-completed">Bitiş Tarihi Geçti</p>
                                    }
                                    else if (remainingTime <= TimeSpan.FromDays(1))
                                    {
                                        <p class="deadline-warning">Bitiş Tarihine Az Kaldı!</p>
                                    }
                                    else
                                    {
                                        <p class="deadline-approaching">Bitiş Tarihine 1 Günden Fazla Var</p>
                                    }
                                }
                            </div>
                            <div class="card-footer">
                                <a href="@Url.Action("Edit", "Gorev", new { id = gorev.Id })" class="btn btn-primary btn-sm">Düzenle</a>
                                <a href="@Url.Action("Delete", "Gorev", new { id = gorev.Id })" class="btn btn-danger btn-sm" onclick="return confirm('Bu görevi silmek istediğinizden emin misiniz?')">Sil</a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="text-center">Görev bulunamadı.</p>
            }
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        function searchTask() {
            var input = document.getElementById("search");
            var filter = input.value.toLowerCase();
            var tasks = document.querySelectorAll(".task-card");

            tasks.forEach(function(task) {
                var taskName = task.querySelector(".card-header").innerText.toLowerCase();
                if (taskName.indexOf(filter) > -1) {
                    task.style.display = "";
                } else {
                    task.style.display = "none";
                }
            });
        }
    </script>

</body>
</html>
