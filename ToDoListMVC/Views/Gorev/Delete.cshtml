@model ToDoListMVC.Models.Gorev

@{
    ViewData["Title"] = "Görevi Sil";
}

<div class="container mt-5">
    <h2 class="text-center text-danger">🚨 Görevi Sil</h2>

    <div class="alert alert-warning text-center">
        <p><strong>@Model.TaskName</strong> görevini silmek istediğinize emin misiniz?</p>
    </div>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="text-center">
            <button type="submit" class="btn btn-danger">🗑️ Sil</button>
            <a asp-action="Index" class="btn btn-secondary">İptal</a>
        </div>
    </form>
</div>
